#PlayButton > .unity-button:hover {
    background-color: rgb(0, 255, 0);
}

#PlayButton:checked > .unity-button {
    background-color: rgb(255, 52, 0);
}

#PlayButton > .unity-button {
    border-top-left-radius: 5px;
    border-bottom-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    min-width: 25px;
    min-height: 22px;
    margin-left: 2px;
    margin-right: 2px;
    margin-top: 2px;
    margin-bottom: 2px;
    padding-left: 2px;
    padding-right: 2px;
    padding-top: 2px;
    padding-bottom: 2px;
    -unity-slice-left: 1;
    -unity-slice-top: 1;
    -unity-slice-right: 1;
    -unity-slice-bottom: 1;
}

#SaveAnimationClip > .unity-popup-field__input {
    border-left-width: 0;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    margin-top: 1px;
    margin-bottom: 1px;
    min-width: 0;
    min-height: 0;
    border-left-color: rgb(149, 149, 149);
    border-right-color: rgb(149, 149, 149);
    border-top-color: rgb(149, 149, 149);
    border-bottom-color: rgb(149, 149, 149);
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-top-left-radius: initial;
    border-bottom-left-radius: initial;
}
