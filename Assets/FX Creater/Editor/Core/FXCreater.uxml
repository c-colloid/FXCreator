<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/FX%20Creater/Editor/Core/FXCreater.uss?fileID=7433441132597879392&amp;guid=d9744d794cab3504c89ffe43dafd7480&amp;type=3#FXCreater" />
    <ui:Label text="Animation(Clip) Folder Path" />
    <ui:VisualElement name="Animations" style="flex-direction: row; align-items: stretch; justify-content: space-between;">
        <CustomUI.BetterTextField placeholder="Assets/YourAnimationFolder" readonly="true" name="FolderPath" view-data-key="FolderPath" focusable="true" tabindex="-1" style="margin-left: 5px; margin-right: 5px; margin-top: 2px; margin-bottom: 2px; width: 100%; max-width: 100%; flex-shrink: 1;">
            <ui:Button name="FolderPathReset" focusable="false" style="position: absolute; top: 2px; right: 0; bottom: 2px; width: 20px; -unity-background-scale-mode: scale-to-fit;" />
        </CustomUI.BetterTextField>
        <ui:Button name="AnimationsFolder" focusable="false" style="margin-left: 5px; margin-right: 5px; margin-top: 2px; margin-bottom: 2px; -unity-background-scale-mode: scale-to-fit; width: 30px;" />
    </ui:VisualElement>
    <ui:VisualElement style="margin-top: 5px; margin-bottom: 5px;" />
    <ui:Label text="Create New Animation(Clip)" />
    <ui:VisualElement name="AnimationClip" style="flex-direction: row; align-items: stretch; justify-content: space-between;">
        <CustomUI.BetterTextField placeholder="New Animation(Clip) Name" name="AnimationName" tabindex="-1" style="width: 100%; max-width: 100%; display: flex; visibility: visible; flex-shrink: 1; margin-left: 5px; margin-right: 5px;">
            <ui:Button name="ResetAnimationName" focusable="false" style="position: absolute; top: 2px; right: 0; bottom: 2px; width: 20px; -unity-background-scale-mode: scale-to-fit;" />
        </CustomUI.BetterTextField>
        <ui:VisualElement style="flex-direction: row; justify-content: space-around;">
            <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="SaveAnimationClip" focusable="false" style="margin-left: 5px; margin-right: 0; -unity-background-scale-mode: scale-to-fit; padding-right: 0; border-right-width: 0; border-top-right-radius: initial; border-bottom-right-radius: initial; width: 23px;" />
            <ui:DropdownField index="-1" name="SaveAnimationClip" focusable="false" choices="Empty,IsActive,BlendShape" style="margin-left: 0; margin-right: 5px; width: 10px; display: flex;" />
            <ui:EnumField type="colloid.FXCreater.FXCreater+SaveType, FXCreater" name="SaveAnimationClip" include-obsolete-values="false" style="margin-left: 0; margin-right: 5px; width: 10px; display: none;" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="Render" focusable="true" style="flex-grow: 1; background-image: none; background-color: rgb(0, 0, 0); flex-shrink: 0; margin-left: 3px; margin-right: 3px; margin-top: 3px; margin-bottom: 3px; padding-left: 1px; padding-right: 1px; padding-top: 1px; padding-bottom: 1px; border-top-left-radius: 5px; border-bottom-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; transition-duration: 107ms;">
        <ui:VisualElement style="flex-direction: row;">
            <CustomUI.DropDownField name="ClipsDropDown" focusable="false" style="flex-grow: 1;" />
            <ui:Button name="AnimationFile" focusable="false" style="width: 20px; margin-right: 10px; margin-left: 10px;" />
        </ui:VisualElement>
        <ui:VisualElement name="RenderPlayer" style="flex-direction: row; align-items: center; justify-content: space-between; align-self: center; margin-left: 2px; margin-right: 2px; margin-top: 0; margin-bottom: 3px; max-width: 100%;">
            <CustomUI.ToggleinButton name="PlayButton" tooltip="Play" focusable="false" />
            <ui:Slider picking-mode="Ignore" name="PlaySlider" focusable="true" tabindex="-1" style="margin-right: 2px; min-height: auto; margin-left: 2px; margin-top: 2px; margin-bottom: 2px; flex-shrink: 1; align-self: center; justify-content: space-between;" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:EnumField type="colloid.FXCreater.FXCreater+SaveType, FXCreater" focusable="false" />
</ui:UXML>
