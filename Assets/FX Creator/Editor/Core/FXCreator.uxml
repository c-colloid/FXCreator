<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/FX%20Creator/Editor/Core/FXCreator.uss?fileID=7433441132597879392&amp;guid=d9744d794cab3504c89ffe43dafd7480&amp;type=3#FXCreator" />
    <ui:Label text="Animation(Clip) Folder Path" />
    <ui:VisualElement name="Animations" style="flex-direction: row; align-items: stretch; justify-content: space-between;">
        <colloid.FXCreator.UI.BetterTextField placeholder="Assets/YourAnimationFolder" readonly="true" name="FolderPath" view-data-key="FolderPath" style="margin-left: 5px; margin-right: 5px; margin-top: 2px; margin-bottom: 2px; width: 100%; max-width: 100%; flex-shrink: 1;">
            <ui:Button name="FolderPathReset" style="position: absolute; top: 2px; right: 0; bottom: 2px; width: 20px; -unity-background-scale-mode: scale-to-fit;" />
        </colloid.FXCreator.UI.BetterTextField>
        <ui:Button name="AnimationsFolder" style="margin-left: 5px; margin-right: 5px; margin-top: 2px; margin-bottom: 2px; -unity-background-scale-mode: scale-to-fit; width: 30px;" />
    </ui:VisualElement>
    <ui:VisualElement style="margin-top: 5px; margin-bottom: 5px;" />
    <ui:Label text="Create New Animation(Clip)" />
    <ui:VisualElement name="AnimationClip" style="flex-direction: row; align-items: stretch; justify-content: space-between;">
        <colloid.FXCreator.UI.BetterTextField placeholder="New Animation(Clip) Name" name="AnimationName" style="width: 100%; max-width: 100%; display: flex; visibility: visible; flex-shrink: 1; margin-left: 5px; margin-right: 5px;">
            <ui:Button name="ResetAnimationName" style="position: absolute; top: 2px; right: 0; bottom: 2px; width: 20px; -unity-background-scale-mode: scale-to-fit;" />
        </colloid.FXCreator.UI.BetterTextField>
        <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="SaveAnimationClip" style="width: 30px; margin-left: 5px; margin-right: 5px; -unity-background-scale-mode: scale-to-fit;" />
    </ui:VisualElement>
    <ui:VisualElement name="Render" focusable="true" style="flex-grow: 1; background-image: none; background-color: rgb(0, 0, 0); flex-shrink: 0; margin-left: 3px; margin-right: 3px; margin-top: 3px; margin-bottom: 3px; padding-left: 1px; padding-right: 1px; padding-top: 1px; padding-bottom: 1px; border-top-left-radius: 5px; border-bottom-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px;">
        <ui:VisualElement style="flex-direction: row;">
            <colloid.FXCreator.UI.DropDownField name="ClipsDropDown" focusable="false" style="flex-grow: 1;" />
            <ui:Button name="AnimationFile" style="width: 20px; margin-right: 10px; margin-left: 10px;" />
        </ui:VisualElement>
        <ui:VisualElement name="RenderPlayer" style="flex-direction: row; align-items: center; justify-content: space-between; align-self: center; margin-left: 2px; margin-right: 2px; margin-top: 0; margin-bottom: 3px; max-width: 100%;">
            <colloid.FXCreator.UI.ToggleinButton name="PlayButton" tooltip="Play" focusable="false" />
            <ui:Slider picking-mode="Ignore" name="PlaySlider" style="margin-right: 2px; min-height: auto; margin-left: 2px; margin-top: 2px; margin-bottom: 2px; flex-shrink: 1; align-self: center; justify-content: space-between;" />
            <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="PlayButton" style="flex-shrink: 1; padding-left: 2px; padding-right: 2px; padding-top: 2px; padding-bottom: 2px; margin-left: 2px; margin-right: 2px; margin-top: 2px; margin-bottom: 2px; min-width: 25px; min-height: 22px; -unity-slice-left: 1; -unity-slice-top: 1; -unity-slice-right: 1; -unity-slice-bottom: 1; border-top-left-radius: 5px; border-bottom-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; display: none;" />
            <colloid.FXCreator.UI.ToggleButton name="PlayButton" display-tooltip-when-elided="true" parse-escape-sequences="true" value="true" class="unity-toggle__checkmark" style="flex-shrink: 1; margin-left: 2px; margin-right: 2px; margin-top: 2px; margin-bottom: 2px; border-top-left-radius: 5px; border-bottom-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; -unity-slice-left: 1; -unity-slice-top: 1; -unity-slice-right: 1; -unity-slice-bottom: 1; min-width: 25px; min-height: 23px; display: none;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
