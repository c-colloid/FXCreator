.unity-foldout--depth-0 {
    background-color: rgba(219, 225, 226, 0.8);
}

.unity-foldout__toggle {
    background-color: rgba(214, 244, 250, 0.8);
    margin-top: 0;
    margin-bottom: 0;
    margin-right: 0;
    margin-left: 0;
}

.unity-foldout__toggle:hover {
    background-color: var(--unity-colors-button-background);
}

.unity-list-view#InAnimatorParametersList {
    padding-bottom: 4px;
    padding-left: 0;
    padding-right: 4px;
    padding-top: 4px;
}

.unity-text-field#FilterTextField {
    padding-right: 4px;
    padding-top: 1px;
}

#FilterButtons {
    padding-top: 2px;
}

.unity-list-view {
    padding-top: 4px;
    padding-bottom: 4px;
}

#InAnimatorParameters {
    margin-top: 4px;
}
